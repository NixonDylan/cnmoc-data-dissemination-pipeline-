<dataset type="EDDTableFromDatabase" datasetID="buoy_telemetry_optimized" active="true">
    <!-- 1. Secure Routing Properties (Credentials Parameterized for Public Repo) -->
    <driverClassName>org.postgresql.Driver</driverClassName>
    <connectionString>jdbc:postgresql://${env.DB_HOST}:5432/${env.DB_NAME}</connectionString>
    <dbUser>${env.ERDDAP_READ_USER}</dbUser>
    <dbPassword>${env.ERDDAP_READ_PASSWORD}</dbPassword>
    <catalogName></catalogName>
    <schemaName>public</schemaName>
    <tableName>telemetry_table</tableName>
   
    <!-- 2. Performance Tuning & Freshness SLA -->
    <reloadEveryNMinutes>5</reloadEveryNMinutes>
    <redirectFirstStationToFetchAllOnFirstRequest>false</redirectFirstStationToFetchAllOnFirstRequest>
    <maxRecords>500000</maxRecords> <!-- Defensive guard against query-based memory exhaustion -->

    <!-- 3. Global Metadata (CF-1.6 / Attribute Convention for Data Discovery Compliance) -->
    <sourceAttributes>
    </sourceAttributes>
    <addAttributes>
        <att name="cdm_data_type">TimeSeries</att>
        <att name="conventions">CF-1.6, COARDS, ACDD-1.3</att>
        <att name="infoUrl">https://navy.mil</att>
        <att name="institution">Commander, Naval Meteorology and Oceanography Command (CNMOC)</att>
        <att name="keywords">buoy, sea, surface, temperature, telemetry, oceanography, cnmoc</att>
        <att name="license">For official naval operational and scientific use. Subject to DISA STIG access controls.</att>
        <att name="sourceUrl">(local database)</att>
        <att name="standard_name_vocabulary">CF Standard Name Table v70</att>
        <att name="title">Optimized Real-Time Buoy Telemetry Data Stream</att>
    </addAttributes>

    <!-- 4. Data Variable Mapping & Standard Name Enforcements -->
   
    <!-- Unique Station Identifier -->
    <dataVariable>
        <sourceName>buoy_id</sourceName>
        <destinationName>station_id</destinationName>
        <dataType>String</dataType>
        <addAttributes>
            <att name="cf_role">timeseries_id</att>
            <att name="long_name">Buoy Platform Identifier</att>
        </addAttributes>
    </dataVariable>

    <!-- Time Coordinate (Must be in UTC in database) -->
    <dataVariable>
        <sourceName>time</sourceName>
        <destinationName>time</destinationName>
        <dataType>String</dataType> <!-- ERDDAP converts Timestamp strings internally -->
        <addAttributes>
            <att name="long_name">Observation Time</att>
            <att name="standard_name">time</att>
            <att name="units">yyyy-MM-dd'T'HH:mm:ss'Z'</att>
        </addAttributes>
    </dataVariable>

    <!-- Latitude Coordinate -->
    <dataVariable>
        <sourceName>latitude</sourceName>
        <destinationName>latitude</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Latitude</att>
            <att name="standard_name">latitude</att>
            <att name="units">degrees_north</att>
        </addAttributes>
    </dataVariable>

    <!-- Longitude Coordinate -->
    <dataVariable>
        <sourceName>longitude</sourceName>
        <destinationName>longitude</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Longitude</att>
            <att name="standard_name">longitude</att>
            <att name="units">degrees_east</att>
        </addAttributes>
    </dataVariable>

    <!-- Sea Surface Temperature (Observed Variable) -->
    <dataVariable>
        <sourceName>sea_surface_temperature</sourceName>
        <destinationName>sea_surface_temperature</destinationName>
        <dataType>double</dataType>
        <addAttributes>
            <att name="long_name">Sea Surface Temperature</att>
            <!-- CF-1.6 Mandatory Standard Name -->
            <att name="standard_name">sea_surface_temperature</att>
            <!-- Enforced Unit Standard -->
            <att name="units">degree_Celsius</att>
            <att name="ioos_category">Temperature</att>
        </addAttributes>
    </dataVariable>

</dataset>
